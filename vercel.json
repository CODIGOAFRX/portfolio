{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/proyecto/aforo",
      "destination": "https://aforo.pedrojgomezperez.workers.dev/proyecto/aforo"
    },
    {
      "source": "/proyecto/aforo/:path*",
      "destination": "https://aforo.pedrojgomezperez.workers.dev/proyecto/aforo/:path*"
    },
    {
      "source": "/proyecto/pera-erp/api/:path*",
      "destination": "https://pera-demo.pedrojgomezperez.workers.dev/api/:path*"
    },
    {
      "source": "/proyecto/pera-erp/app",
      "destination": "/proyecto/pera-erp/app/"
    },
    {
      "source": "/proyecto/pera-erp/app/:path*",
      "destination": "/proyecto/pera-erp/app/"
    },
    {
      "source": "/admin",
      "destination": "/api/admin"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/horario",
      "destination": "/api/horario-page"
    },
    {
      "source": "/horario/login",
      "destination": "/api/horario-page?view=login"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/((?!proyecto/tune-interrogacion/analyzer\\.worker\\.js$).*)",
      "headers": [{
        "key": "Content-Security-Policy",
        "value": "default-src 'self'; script-src 'self'; worker-src 'self'; media-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
      }]
    },
    {
      "source": "/proyecto/pera-erp/app/(.*)",
      "headers": [
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/proyecto/tune-interrogacion/analyzer.worker.js",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-eval'; connect-src 'self'; object-src 'none'; base-uri 'none'" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/login",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/horario(/login)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
